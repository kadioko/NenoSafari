{
  "name": "neno-safari",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-friendly Tanzanian Swahili vocabulary word search game.",
  "type": "module",
  "scripts": {
    "test": "node ./scripts/validate-content.mjs && node ./scripts/test-puzzle-engine.mjs && node ./scripts/test-storage.mjs && node ./scripts/test-offline-packs.mjs && node ./scripts/test-app-boot.mjs",
    "test:app": "node ./scripts/test-app-boot.mjs",
    "test:content": "node ./scripts/validate-content.mjs",
    "test:packs": "node ./scripts/test-offline-packs.mjs",
    "test:puzzle": "node ./scripts/test-puzzle-engine.mjs",
    "test:storage": "node ./scripts/test-storage.mjs",
    "test:browser": "node ./scripts/test-browser-flow.mjs",
    "audio:check": "node ./scripts/check-audio.mjs",
    "audio:missing": "node ./scripts/list-missing-audio.mjs",
    "audio:elevenlabs": "node ./scripts/generate-elevenlabs-audio.mjs",
    "screenshots:store": "node ./scripts/capture-store-screenshots.mjs",
    "mobile:build": "node ./scripts/build-mobile.mjs",
    "cap:sync": "npm run mobile:build && npx cap sync",
    "android:add": "npm run mobile:build && npx cap add android",
    "android:open": "npm run cap:sync && npx cap open android",
    "ios:add": "npm run mobile:build && npx cap add ios",
    "ios:open": "npm run cap:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1"
  }
}
